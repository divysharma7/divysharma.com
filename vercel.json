{
	"functions": {
		"api/health.js": {
			"maxDuration": 10
		},
		"api/chat.js": {
			"maxDuration": 30
		}
	},
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		},
		{
			"source": "/fonts/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		}
	],
	"routes": [
		{
			"src": "/spotify",
			"status": 308,
			"headers": {
				"Location": "https://open.spotify.com/user/31wan4heyahmjpej4evvpzwzjnji"
			}
		},
		{
			"src": "/twitter",
			"status": 308,
			"headers": {
				"Location": "https://twitter.com/Divy_Sharma6"
			}
		},
		{
			"src": "/twt",
			"status": 308,
			"headers": {
				"Location": "https://twitter.com/Divy_Sharma6"
			}
		},
		{
			"src": "/ig",
			"status": 308,
			"headers": {
				"Location": "https://www.instagram.com/divy.sharma9/"
			}
		},
		{
			"src": "/instagram",
			"status": 308,
			"headers": {
				"Location": "https://www.instagram.com/divy.sharma9/"
			}
		},
		{
			"src": "/ponder/(.*)",
			"dest": "https://ponder.vercel.app/$1"
		},
		{
			"src": "/spotifyactivity/(.*)",
			"dest": "https://spotact-website.vercel.app/$1"
		},
		{
			"src": "/api/(.*)",
			"headers": {
				"Access-Control-Allow-Credentials": "true",
				"Access-Control-Allow-Origin": "https://divysharma.com",
				"Access-Control-Allow-Methods": "GET,OPTIONS,PATCH,DELETE,POST,PUT",
				"Access-Control-Allow-Headers": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version",
				"X-Frame-Options": "DENY",
				"X-Content-Type-Options": "nosniff",
				"Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
				"Referrer-Policy": "strict-origin-when-cross-origin",
				"X-XSS-Protection": "1; mode=block",
				"Permissions-Policy": "camera=(), microphone=(), geolocation=()"
			},
			"continue": true
		},
		{
			"src": "(.*)",
			"headers": {
				"X-Frame-Options": "DENY",
				"X-Content-Type-Options": "nosniff",
				"Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
				"Referrer-Policy": "strict-origin-when-cross-origin",
				"X-XSS-Protection": "1; mode=block",
				"Permissions-Policy": "camera=(), microphone=(), geolocation=()"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/(.*)",
			"dest": "/index.html"
		}
	],
	"github": {
		"autoAlias": true,
		"enabled": true,
		"silent": true
	}
}
