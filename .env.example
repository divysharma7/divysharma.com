# ============================================================
# divysharma.com — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# Spotify Integration
# Used by: api/spotify.js, api/top-tracks.js, lib/spotify.js
# ----------------------------------------------------------

# (required) Spotify OAuth app credentials — create at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# (required) Long-lived refresh token obtained via the OAuth flow (see scripts/spotify-auth.js)
SPOTIFY_REFRESH_TOKEN=

# (optional) Redirect URI for the Spotify auth helper script — defaults to http://127.0.0.1:3000
SPOTIFY_REDIRECT_URI=

# (required) Set to "true" to enable the Spotify now-playing and top-tracks endpoints
ENABLE_SPOTIFY=true

# ----------------------------------------------------------
# AI Chat — Mistral
# Used by: api/chat.js, lib/rag/upstashVector.js (embeddings)
# ----------------------------------------------------------

# (required) Mistral API key — https://console.mistral.ai/
MISTRAL_API_KEY=

# ----------------------------------------------------------
# Vector Database — Upstash Vector
# Used by: lib/rag/upstashVector.js (RAG retrieval & ingestion)
# ----------------------------------------------------------

# (required) Upstash Vector REST endpoint and token — https://console.upstash.com/
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ----------------------------------------------------------
# RAG Ingestion Auth
# Used by: api/ingest.js
# ----------------------------------------------------------

# (required) Bearer token that protects the /api/ingest endpoint
INGEST_API_KEY=

# ----------------------------------------------------------
# Email — SendGrid
# Used by: api/contact.js
# ----------------------------------------------------------

# (required) SendGrid API key — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# (optional) Recipient email for the contact form — defaults to divy@example.com
CONTACT_EMAIL=

# ----------------------------------------------------------
# Analytics — Umami (client-side, must be prefixed with VITE_)
# Used by: src/analytics/umami.js
# ----------------------------------------------------------

# (optional) Enable/disable Umami analytics — defaults to "true"
VITE_UMAMI_ENABLED=true

# (required for analytics) Your Umami website ID
VITE_UMAMI_WEBSITE_ID=

# (optional) Umami tracker script URL — defaults to https://cloud.umami.is/script.js
VITE_UMAMI_SRC=https://cloud.umami.is/script.js

# (optional) Custom Umami collector endpoint (for self-hosted / proxy setups)
VITE_UMAMI_HOST_URL=

# (optional) Comma-separated list of domains to restrict tracking to (e.g. divysharma.com)
VITE_UMAMI_DOMAINS=
